/* Gaming Admin Panel - Modern Design */
@import url('https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;500;600;700&family=Orbitron:wght@400;500;600;700;800;900&display=swap');

/* Scoped to admin container only */
.admin-container {
  --primary-orange: #ff6b35;
  --secondary-orange: #f97316;
  --dark-orange: #ea580c;
  --light-orange: #fb923c;
  --accent-blue: #3b82f6;
  --accent-purple: #a855f7;
  --success-green: #10b981;
  --dark-bg: #0f172a;
  --darker-bg: #020617;
  --card-bg: rgba(30, 41, 59, 0.9);
  --glass-bg: rgba(255, 107, 53, 0.05);
  --border-glow: rgba(255, 107, 53, 0.3);
  font-family: 'Rajdhani', sans-serif;
}

.admin-container {
  display: flex;
  min-height: 100vh;
  background: linear-gradient(135deg, #0a0e27 0%, #1a1f3a 50%, #0a0e27 100%);
  position: relative;
  overflow: hidden;
}

/* Animated Background */
.admin-container::before {
  content: '';
  position: fixed;
  width: 200%;
  height: 200%;
  background: 
    radial-gradient(circle at 20% 50%, rgba(0, 240, 255, 0.1) 0%, transparent 50%),
    radial-gradient(circle at 80% 80%, rgba(181, 55, 242, 0.1) 0%, transparent 50%),
    radial-gradient(circle at 40% 20%, rgba(255, 0, 110, 0.1) 0%, transparent 50%);
  animation: backgroundMove 20s ease-in-out infinite;
  z-index: 0;
}

@keyframes backgroundMove {
  0%, 100% { transform: translate(0, 0) rotate(0deg); }
  50% { transform: translate(-50px, -50px) rotate(180deg); }
}

/* Sidebar */
.admin-sidebar {
  width: 300px;
  background: rgba(10, 14, 39, 0.95);
  backdrop-filter: blur(20px);
  border-right: 1px solid var(--border-glow);
  position: relative;
  z-index: 10;
  box-shadow: 0 0 40px rgba(0, 240, 255, 0.1);
}

.admin-logo {
  padding: 2rem 1.5rem;
  border-bottom: 1px solid rgba(0, 240, 255, 0.2);
  background: linear-gradient(135deg, rgba(0, 240, 255, 0.1) 0%, rgba(181, 55, 242, 0.1) 100%);
}

.admin-logo h2 {
  font-family: 'Orbitron', sans-serif;
  font-size: 1.75rem;
  font-weight: 900;
  background: linear-gradient(135deg, var(--neon-cyan) 0%, var(--neon-purple) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  text-transform: uppercase;
  letter-spacing: 3px;
  margin-bottom: 0.5rem;
  text-shadow: 0 0 20px rgba(0, 240, 255, 0.5);
}

.admin-user {
  color: rgba(255, 255, 255, 0.6);
  font-size: 0.9rem;
  font-weight: 500;
}

.admin-nav {
  padding: 1.5rem 1rem;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.admin-nav button {
  background: var(--glass-bg);
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.7);
  padding: 1rem 1.25rem;
  text-align: left;
  cursor: pointer;
  border-radius: 12px;
  font-size: 1rem;
  font-weight: 600;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.admin-nav button::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(0, 240, 255, 0.3), transparent);
  transition: left 0.5s;
}

.admin-nav button:hover::before {
  left: 100%;
}

.admin-nav button:hover {
  background: rgba(0, 240, 255, 0.1);
  border-color: var(--neon-cyan);
  color: #fff;
  transform: translateX(5px);
  box-shadow: 0 0 20px rgba(0, 240, 255, 0.3);
}

.admin-nav button.active {
  background: linear-gradient(135deg, rgba(0, 240, 255, 0.2) 0%, rgba(181, 55, 242, 0.2) 100%);
  border: 1px solid var(--neon-cyan);
  color: #fff;
  box-shadow: 
    0 0 30px rgba(0, 240, 255, 0.4),
    inset 0 0 20px rgba(0, 240, 255, 0.1);
  transform: translateX(5px);
}

.nav-divider {
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--neon-cyan), transparent);
  margin: 1rem 0;
  opacity: 0.3;
}

.btn-back {
  margin-top: auto;
  background: rgba(255, 0, 110, 0.1) !important;
  border: 1px solid rgba(255, 0, 110, 0.3) !important;
  color: var(--neon-pink) !important;
}

.btn-back:hover {
  background: rgba(255, 0, 110, 0.2) !important;
  border-color: var(--neon-pink) !important;
  box-shadow: 0 0 20px rgba(255, 0, 110, 0.4) !important;
}

/* Content Area */
.admin-content {
  flex: 1;
  padding: 2.5rem;
  overflow-y: auto;
  position: relative;
  z-index: 1;
}

/* Dashboard */
.dashboard h1 {
  font-family: 'Orbitron', sans-serif;
  font-size: 2.5rem;
  font-weight: 900;
  background: linear-gradient(135deg, #fff 0%, var(--neon-cyan) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 0.5rem;
  text-transform: uppercase;
  letter-spacing: 2px;
}

.subtitle {
  color: rgba(255, 255, 255, 0.5);
  font-size: 1.1rem;
  margin-bottom: 2.5rem;
  font-weight: 500;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 1.5rem;
  margin-bottom: 2.5rem;
}

.stat-card {
  background: var(--card-bg);
  backdrop-filter: blur(20px);
  padding: 2rem;
  border-radius: 20px;
  border: 1px solid rgba(255, 255, 255, 0.1);
  display: flex;
  align-items: center;
  gap: 1.5rem;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.stat-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: linear-gradient(90deg, transparent, var(--neon-cyan), transparent);
  opacity: 0;
  transition: opacity 0.3s;
}

.stat-card:hover::before {
  opacity: 1;
}

.stat-card:hover {
  transform: translateY(-8px) scale(1.02);
  border-color: var(--neon-cyan);
  box-shadow: 
    0 20px 60px rgba(0, 0, 0, 0.5),
    0 0 40px rgba(0, 240, 255, 0.3),
    inset 0 0 20px rgba(0, 240, 255, 0.05);
}

.stat-card.blue { border-left: 3px solid var(--neon-cyan); }
.stat-card.green { border-left: 3px solid var(--neon-green); }
.stat-card.purple { border-left: 3px solid var(--neon-purple); }
.stat-card.orange { border-left: 3px solid #ff9500; }

.stat-icon {
  font-size: 3rem;
  filter: drop-shadow(0 0 10px currentColor);
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.05); opacity: 0.8; }
}

.stat-info h3 {
  font-family: 'Orbitron', sans-serif;
  font-size: 2.5rem;
  font-weight: 900;
  color: #fff;
  margin: 0;
  text-shadow: 0 0 20px rgba(0, 240, 255, 0.5);
}

.stat-info p {
  color: rgba(255, 255, 255, 0.6);
  font-size: 0.95rem;
  font-weight: 600;
  margin: 0.5rem 0;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.stat-change {
  display: inline-block;
  padding: 0.35rem 0.75rem;
  border-radius: 20px;
  font-size: 0.8rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.stat-change.positive {
  background: rgba(0, 255, 136, 0.2);
  color: var(--neon-green);
  border: 1px solid rgba(0, 255, 136, 0.3);
  box-shadow: 0 0 10px rgba(0, 255, 136, 0.2);
}

.stat-change.neutral {
  background: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.7);
  border: 1px solid rgba(255, 255, 255, 0.2);
}

/* Dashboard Grid */
.dashboard-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
  gap: 1.5rem;
}

.dashboard-card {
  background: var(--card-bg);
  backdrop-filter: blur(20px);
  padding: 2rem;
  border-radius: 20px;
  border: 1px solid rgba(255, 255, 255, 0.1);
  transition: all 0.3s;
}

.dashboard-card:hover {
  border-color: var(--neon-cyan);
  box-shadow: 0 0 30px rgba(0, 240, 255, 0.2);
}

.dashboard-card h3 {
  font-family: 'Orbitron', sans-serif;
  font-size: 1.3rem;
  font-weight: 700;
  color: #fff;
  margin-bottom: 1.5rem;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.activity-list {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.activity-item {
  display: flex;
  gap: 1rem;
  padding: 1rem;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 12px;
  border: 1px solid rgba(255, 255, 255, 0.05);
  transition: all 0.3s;
}

.activity-item:hover {
  background: rgba(0, 240, 255, 0.05);
  border-color: rgba(0, 240, 255, 0.3);
  transform: translateX(5px);
}

.activity-icon {
  font-size: 1.75rem;
  filter: drop-shadow(0 0 5px currentColor);
}

.activity-content p {
  color: rgba(255, 255, 255, 0.9);
  font-size: 0.95rem;
  font-weight: 500;
  margin: 0;
}

.activity-time {
  color: rgba(255, 255, 255, 0.4);
  font-size: 0.8rem;
  margin-top: 0.25rem;
  display: block;
}

.quick-stats {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.quick-stat-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1rem;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 12px;
  border: 1px solid rgba(255, 255, 255, 0.05);
  transition: all 0.3s;
}

.quick-stat-item:hover {
  background: rgba(181, 55, 242, 0.05);
  border-color: rgba(181, 55, 242, 0.3);
}

.quick-stat-item .label {
  color: rgba(255, 255, 255, 0.7);
  font-size: 0.9rem;
  font-weight: 500;
}

.quick-stat-item .value {
  font-family: 'Orbitron', sans-serif;
  font-size: 1.5rem;
  font-weight: 900;
  color: #fff;
  text-shadow: 0 0 10px rgba(0, 240, 255, 0.5);
}

.quick-stat-item .value.warning {
  color: #ff9500;
  text-shadow: 0 0 10px rgba(255, 149, 0, 0.5);
}

/* Management Section */
.management-section {
  animation: slideIn 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes slideIn {
  from { 
    opacity: 0; 
    transform: translateY(30px);
  }
  to { 
    opacity: 1; 
    transform: translateY(0);
  }
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 2rem;
}

.section-header h1 {
  font-family: 'Orbitron', sans-serif;
  font-size: 2.5rem;
  font-weight: 900;
  background: linear-gradient(135deg, #fff 0%, var(--neon-cyan) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 0.5rem;
  text-transform: uppercase;
  letter-spacing: 2px;
}

/* Filters */
.filters-bar {
  display: flex;
  gap: 1rem;
  margin-bottom: 2rem;
}

.search-input,
.filter-select {
  padding: 1rem 1.25rem;
  background: var(--card-bg);
  backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 12px;
  color: #fff;
  font-size: 1rem;
  font-weight: 500;
  transition: all 0.3s;
}

.search-input {
  flex: 1;
}

.search-input:focus,
.filter-select:focus {
  outline: none;
  border-color: var(--neon-cyan);
  box-shadow: 0 0 20px rgba(0, 240, 255, 0.3);
  background: rgba(0, 240, 255, 0.05);
}

.search-input::placeholder {
  color: rgba(255, 255, 255, 0.4);
}

/* Buttons */
.btn-add {
  padding: 1rem 2rem;
  background: linear-gradient(135deg, var(--neon-cyan) 0%, var(--neon-purple) 100%);
  border: none;
  border-radius: 12px;
  color: #fff;
  font-size: 1rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1px;
  cursor: pointer;
  transition: all 0.3s;
  box-shadow: 0 0 30px rgba(0, 240, 255, 0.4);
  position: relative;
  overflow: hidden;
}

.btn-add::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  transform: translate(-50%, -50%);
  transition: width 0.6s, height 0.6s;
}

.btn-add:hover::before {
  width: 300px;
  height: 300px;
}

.btn-add:hover {
  transform: translateY(-3px);
  box-shadow: 0 0 50px rgba(0, 240, 255, 0.6);
}

.btn-add:active {
  transform: translateY(-1px);
}

.btn-icon {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  padding: 0.6rem;
  cursor: pointer;
  font-size: 1.1rem;
  border-radius: 8px;
  transition: all 0.3s;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.btn-icon:hover {
  background: rgba(0, 240, 255, 0.1);
  border-color: var(--neon-cyan);
  transform: scale(1.1);
  box-shadow: 0 0 15px rgba(0, 240, 255, 0.3);
}

.btn-icon.danger:hover {
  background: rgba(255, 0, 110, 0.1);
  border-color: var(--neon-pink);
  box-shadow: 0 0 15px rgba(255, 0, 110, 0.3);
}

.action-buttons {
  display: flex;
  gap: 0.5rem;
}

/* Table */
.table-container {
  background: var(--card-bg);
  backdrop-filter: blur(20px);
  border-radius: 20px;
  border: 1px solid rgba(255, 255, 255, 0.1);
  overflow: hidden;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
}

.data-table {
  width: 100%;
  border-collapse: collapse;
}

.data-table thead {
  background: rgba(0, 240, 255, 0.05);
  border-bottom: 2px solid rgba(0, 240, 255, 0.3);
}

.data-table th {
  padding: 1.25rem 1.5rem;
  text-align: left;
  font-family: 'Orbitron', sans-serif;
  font-weight: 700;
  color: var(--neon-cyan);
  font-size: 0.85rem;
  text-transform: uppercase;
  letter-spacing: 1.5px;
}

.data-table td {
  padding: 1.25rem 1.5rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
}

.data-table tbody tr {
  transition: all 0.3s;
}

.data-table tbody tr:hover {
  background: rgba(0, 240, 255, 0.05);
  box-shadow: inset 0 0 20px rgba(0, 240, 255, 0.1);
}

.user-cell {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.table-avatar {
  width: 45px;
  height: 45px;
  border-radius: 50%;
  object-fit: cover;
  border: 2px solid var(--neon-cyan);
  box-shadow: 0 0 15px rgba(0, 240, 255, 0.4);
}

.user-name {
  font-weight: 700;
  color: #fff;
  font-size: 1rem;
}

.user-username {
  font-size: 0.85rem;
  color: rgba(255, 255, 255, 0.5);
  margin-top: 0.15rem;
}

.role-badge {
  padding: 0.4rem 1rem;
  border-radius: 20px;
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1px;
  border: 1px solid;
}

.role-badge.admin {
  background: rgba(255, 0, 110, 0.2);
  color: var(--neon-pink);
  border-color: var(--neon-pink);
  box-shadow: 0 0 10px rgba(255, 0, 110, 0.3);
}

.role-badge.moderator {
  background: rgba(255, 149, 0, 0.2);
  color: #ff9500;
  border-color: #ff9500;
  box-shadow: 0 0 10px rgba(255, 149, 0, 0.3);
}

.role-badge.user {
  background: rgba(0, 240, 255, 0.2);
  color: var(--neon-cyan);
  border-color: var(--neon-cyan);
  box-shadow: 0 0 10px rgba(0, 240, 255, 0.3);
}

.status-badge {
  padding: 0.4rem 1rem;
  border-radius: 20px;
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1px;
  border: 1px solid;
}

.status-badge.active {
  background: rgba(0, 255, 136, 0.2);
  color: var(--neon-green);
  border-color: var(--neon-green);
  box-shadow: 0 0 10px rgba(0, 255, 136, 0.3);
  animation: statusPulse 2s ease-in-out infinite;
}

@keyframes statusPulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.7; }
}

.status-badge.sent {
  background: rgba(0, 240, 255, 0.2);
  color: var(--neon-cyan);
  border-color: var(--neon-cyan);
  box-shadow: 0 0 10px rgba(0, 240, 255, 0.3);
}

/* Notifications */
.notifications-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
  gap: 1.5rem;
}

.notification-card {
  background: var(--card-bg);
  backdrop-filter: blur(20px);
  padding: 1.75rem;
  border-radius: 16px;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-left: 4px solid;
  transition: all 0.3s;
  position: relative;
  overflow: hidden;
}

.notification-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, transparent 0%, rgba(255, 255, 255, 0.03) 100%);
  opacity: 0;
  transition: opacity 0.3s;
}

.notification-card:hover::before {
  opacity: 1;
}

.notification-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 15px 40px rgba(0, 0, 0, 0.4);
}

.notification-card.info { 
  border-left-color: var(--neon-cyan); 
}
.notification-card.info:hover {
  box-shadow: 0 15px 40px rgba(0, 240, 255, 0.3);
}

.notification-card.success { 
  border-left-color: var(--neon-green); 
}
.notification-card.success:hover {
  box-shadow: 0 15px 40px rgba(0, 255, 136, 0.3);
}

.notification-card.warning { 
  border-left-color: #ff9500; 
}
.notification-card.warning:hover {
  box-shadow: 0 15px 40px rgba(255, 149, 0, 0.3);
}

.notification-card.error { 
  border-left-color: var(--neon-pink); 
}
.notification-card.error:hover {
  box-shadow: 0 15px 40px rgba(255, 0, 110, 0.3);
}

.notification-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 1rem;
}

.notification-header h3 {
  font-family: 'Orbitron', sans-serif;
  font-size: 1.15rem;
  font-weight: 700;
  color: #fff;
  margin: 0;
}

.notification-message {
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.6;
  margin: 0 0 1.25rem 0;
  font-size: 0.95rem;
}

.notification-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 1rem;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
}

.notification-meta {
  font-size: 0.8rem;
  color: rgba(255, 255, 255, 0.4);
  font-weight: 500;
}

/* Modal */
.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.8);
  backdrop-filter: blur(10px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 1rem;
  animation: fadeIn 0.3s;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.modal-content {
  background: var(--darker-bg);
  border: 1px solid rgba(0, 240, 255, 0.3);
  border-radius: 20px;
  width: 100%;
  max-width: 550px;
  max-height: 90vh;
  overflow-y: auto;
  box-shadow: 
    0 0 60px rgba(0, 240, 255, 0.4),
    0 20px 80px rgba(0, 0, 0, 0.8);
  animation: modalSlide 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes modalSlide {
  from { 
    opacity: 0;
    transform: translateY(-50px) scale(0.9);
  }
  to { 
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.modal-content.large {
  max-width: 700px;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 2rem;
  border-bottom: 1px solid rgba(0, 240, 255, 0.2);
  background: linear-gradient(135deg, rgba(0, 240, 255, 0.05) 0%, rgba(181, 55, 242, 0.05) 100%);
}

.modal-header h2 {
  font-family: 'Orbitron', sans-serif;
  font-size: 1.75rem;
  font-weight: 900;
  background: linear-gradient(135deg, #fff 0%, var(--neon-cyan) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin: 0;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.modal-close {
  background: rgba(255, 0, 110, 0.1);
  border: 1px solid rgba(255, 0, 110, 0.3);
  font-size: 1.5rem;
  color: var(--neon-pink);
  cursor: pointer;
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10px;
  transition: all 0.3s;
}

.modal-close:hover {
  background: rgba(255, 0, 110, 0.2);
  transform: rotate(90deg);
  box-shadow: 0 0 20px rgba(255, 0, 110, 0.4);
}

.modal-form {
  padding: 2rem;
}

.form-group {
  margin-bottom: 1.75rem;
}

.form-group label {
  display: block;
  margin-bottom: 0.75rem;
  font-family: 'Orbitron', sans-serif;
  font-weight: 700;
  color: var(--neon-cyan);
  font-size: 0.85rem;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.form-group input,
.form-group textarea,
.form-group select {
  width: 100%;
  padding: 1rem 1.25rem;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 12px;
  font-size: 1rem;
  color: #fff;
  font-family: 'Rajdhani', sans-serif;
  font-weight: 500;
  transition: all 0.3s;
}

.form-group input:focus,
.form-group textarea:focus,
.form-group select:focus {
  outline: none;
  border-color: var(--neon-cyan);
  background: rgba(0, 240, 255, 0.05);
  box-shadow: 0 0 20px rgba(0, 240, 255, 0.2);
}

.form-group textarea {
  resize: vertical;
  min-height: 120px;
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.5rem;
}

.modal-actions {
  display: flex;
  gap: 1rem;
  justify-content: flex-end;
  padding-top: 1.5rem;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
}

.btn-cancel {
  padding: 1rem 2rem;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 12px;
  font-weight: 700;
  cursor: pointer;
  color: rgba(255, 255, 255, 0.7);
  text-transform: uppercase;
  letter-spacing: 1px;
  transition: all 0.3s;
}

.btn-cancel:hover {
  background: rgba(255, 255, 255, 0.1);
  border-color: rgba(255, 255, 255, 0.4);
  color: #fff;
}

.btn-save {
  padding: 1rem 2rem;
  background: linear-gradient(135deg, var(--neon-cyan) 0%, var(--neon-purple) 100%);
  border: none;
  border-radius: 12px;
  font-weight: 700;
  cursor: pointer;
  color: #fff;
  text-transform: uppercase;
  letter-spacing: 1px;
  box-shadow: 0 0 30px rgba(0, 240, 255, 0.4);
  transition: all 0.3s;
}

.btn-save:hover {
  transform: translateY(-2px);
  box-shadow: 0 0 40px rgba(0, 240, 255, 0.6);
}

/* Settings */
.settings-form {
  background: var(--card-bg);
  backdrop-filter: blur(20px);
  border-radius: 20px;
  border: 1px solid rgba(255, 255, 255, 0.1);
  padding: 2.5rem;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
}

.settings-section {
  margin-bottom: 2.5rem;
  padding-bottom: 2.5rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.settings-section:last-of-type {
  border-bottom: none;
}

.settings-section h3 {
  font-family: 'Orbitron', sans-serif;
  font-size: 1.4rem;
  font-weight: 700;
  color: var(--neon-cyan);
  margin: 0 0 1.5rem 0;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.form-group.checkbox label {
  display: flex;
  align-items: center;
  gap: 1rem;
  cursor: pointer;
  padding: 1rem;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 12px;
  border: 1px solid rgba(255, 255, 255, 0.05);
  transition: all 0.3s;
}

.form-group.checkbox label:hover {
  background: rgba(0, 240, 255, 0.05);
  border-color: rgba(0, 240, 255, 0.2);
}

.form-group.checkbox input[type="checkbox"] {
  width: 24px;
  height: 24px;
  cursor: pointer;
  accent-color: var(--neon-cyan);
}

.form-group.checkbox span {
  color: rgba(255, 255, 255, 0.9);
  font-weight: 600;
}

.form-help {
  margin: 0.75rem 0 0 0;
  font-size: 0.85rem;
  color: rgba(255, 255, 255, 0.4);
  font-style: italic;
}

.settings-actions {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 1.5rem;
  padding-top: 2rem;
}

.save-success {
  color: var(--neon-green);
  font-weight: 700;
  font-size: 1rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  animation: successPulse 0.5s ease-in-out;
}

@keyframes successPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

/* Loading */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400px;
  font-family: 'Orbitron', sans-serif;
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--neon-cyan);
  text-transform: uppercase;
  letter-spacing: 2px;
}

.loading::after {
  content: '...';
  animation: dots 1.5s steps(4, end) infinite;
}

@keyframes dots {
  0%, 20% { content: '.'; }
  40% { content: '..'; }
  60%, 100% { content: '...'; }
}

/* Scrollbar Styling */
.admin-content::-webkit-scrollbar,
.modal-content::-webkit-scrollbar {
  width: 10px;
}

.admin-content::-webkit-scrollbar-track,
.modal-content::-webkit-scrollbar-track {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 10px;
}

.admin-content::-webkit-scrollbar-thumb,
.modal-content::-webkit-scrollbar-thumb {
  background: linear-gradient(180deg, var(--neon-cyan) 0%, var(--neon-purple) 100%);
  border-radius: 10px;
  box-shadow: 0 0 10px rgba(0, 240, 255, 0.5);
}

.admin-content::-webkit-scrollbar-thumb:hover,
.modal-content::-webkit-scrollbar-thumb:hover {
  background: linear-gradient(180deg, var(--neon-purple) 0%, var(--neon-cyan) 100%);
}

/* Responsive */
@media (max-width: 1024px) {
  .admin-sidebar {
    width: 260px;
  }
  
  .stats-grid,
  .dashboard-grid,
  .notifications-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 768px) {
  .admin-container {
    flex-direction: column;
  }

  .admin-sidebar {
    width: 100%;
    border-right: none;
    border-bottom: 1px solid rgba(0, 240, 255, 0.3);
  }

  .admin-nav {
    flex-direction: row;
    overflow-x: auto;
    padding: 1rem;
  }

  .admin-nav button {
    white-space: nowrap;
  }

  .admin-content {
    padding: 1.5rem;
  }

  .section-header {
    flex-direction: column;
    gap: 1rem;
  }

  .filters-bar {
    flex-direction: column;
  }

  .form-row {
    grid-template-columns: 1fr;
  }

  .dashboard h1,
  .section-header h1 {
    font-size: 1.75rem;
  }

  .stat-card {
    padding: 1.5rem;
  }

  .stat-icon {
    font-size: 2.5rem;
  }

  .stat-info h3 {
    font-size: 2rem;
  }

  .modal-content {
    max-width: 100%;
    margin: 1rem;
  }

  .modal-header,
  .modal-form {
    padding: 1.5rem;
  }

  .data-table {
    font-size: 0.9rem;
  }

  .data-table th,
  .data-table td {
    padding: 1rem;
  }
}

/* Animations for page transitions */
@keyframes glow {
  0%, 100% {
    text-shadow: 0 0 10px rgba(0, 240, 255, 0.5);
  }
  50% {
    text-shadow: 0 0 20px rgba(0, 240, 255, 0.8), 0 0 30px rgba(0, 240, 255, 0.6);
  }
}

.admin-logo h2 {
  animation: glow 3s ease-in-out infinite;
}

/* Hover effects for interactive elements */
.stat-card,
.dashboard-card,
.notification-card,
.activity-item,
.quick-stat-item {
  cursor: pointer;
}

/* Focus visible for accessibility */
button:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible {
  outline: 2px solid var(--neon-cyan);
  outline-offset: 2px;
}
